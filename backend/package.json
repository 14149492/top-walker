{
  "name": "topwalker-backend", "version": "0.1.0", "private": true,
  "scripts": {
    "dev": "tsc --watch --preserveWatchOutput & node --watch dist/main.js",
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc --noEmit",
    "lint": "eslint src prisma/seed.ts",
    "db:migrate": "prisma migrate deploy",
    "db:seed": "tsx prisma/seed.ts",
    "test:integration": "node --test test/catalog.test.mjs"
  },
  "dependencies": {
    "@nestjs/common": "11.2.11", "@nestjs/core": "11.2.11", "@nestjs/platform-express": "11.2.11",
    "@prisma/client": "6.19.3", "class-transformer": "^0.5.1", "class-validator": "^0.14.2",
    "reflect-metadata": "^0.2.2", "rxjs": "^7.8.2"
  },
  "devDependencies": { "@types/node": "^22.0.0", "typescript": "~5.9.3", "prisma": "6.19.3", "tsx": "^4.20.0", "eslint": "^9.0.0", "typescript-eslint": "^8.0.0" },
  "overrides": { "@prisma/config": { "deepmerge-ts": "8.0.0" } }
}
